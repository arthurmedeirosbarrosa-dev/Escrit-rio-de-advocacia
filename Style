:root{--fundo:#eef2f6;--papel:#fff;--tinta:#17212b;--cab:#274766;--acento:#274766;--ouro:#b8862b;--suave:#5b6875;--borda:#b9c4cf;--resp:#e3ecf5;--erro:#fbe9e7}
:root[data-tema=escuro]{--fundo:#0f1720;--papel:#18222e;--tinta:#e6edf3;--cab:#1b2d42;--acento:#8fb4dc;--ouro:#d2a24a;--suave:#9aa7b4;--borda:#3a4a5c;--resp:#1f3248;--erro:#3a1d1a;color-scheme:dark}
*{box-sizing:border-box}
body{margin:0;font:17px/1.6 system-ui,sans-serif;color:var(--tinta);background:var(--fundo)}
header{display:flex;justify-content:space-between;align-items:center;padding:14px 20px;background:var(--cab);color:#fff;position:sticky;top:0}
.marca{font:600 22px Georgia,serif;color:#fff;text-decoration:none}
#menu-btn{background:none;border:0;padding:8px;cursor:pointer;display:grid;gap:5px;margin:0}
#menu-btn span{display:block;width:26px;height:3px;background:#fff;border-radius:2px}
a:focus-visible,button:focus-visible,textarea:focus-visible,input:focus-visible{outline:3px solid var(--ouro);outline-offset:2px}
nav{position:fixed;top:56px;right:0;width:min(300px,85vw);background:var(--papel);box-shadow:-4px 4px 18px rgba(0,0,0,.3);display:flex;flex-direction:column;z-index:5}
nav[hidden]{display:none}
nav a,nav button{padding:16px 20px;margin:0;color:var(--tinta);text-decoration:none;border:0;border-bottom:1px solid var(--fundo);border-radius:0;background:var(--papel);text-align:left;font:inherit;cursor:pointer}
nav a:hover,nav button:hover{background:var(--fundo)}
main{max-width:680px;margin:0 auto;padding:28px 20px 60px}
h1{font:600 30px/1.25 Georgia,serif;margin:.4em 0 .3em}
a{color:var(--acento)}
label{display:block;font-weight:600;margin:18px 0 6px}
textarea,input[type=email]{width:100%;padding:12px;font:inherit;color:var(--tinta);border:1px solid var(--borda);border-radius:6px;background:var(--papel)}
button,.botao{display:inline-block;font:inherit;padding:11px 20px;border:1px solid var(--acento);background:var(--papel);color:var(--acento);border-radius:6px;cursor:pointer;margin-top:12px;text-decoration:none}
button.primario,.botao{background:var(--cab);border-color:var(--cab);color:#fff}
.lista{list-style:none;padding:0}
.lista a{display:block;padding:14px 16px;margin-bottom:10px;background:var(--papel);border-left:4px solid var(--ouro);color:var(--tinta);text-decoration:none}
.lista small{display:block;color:var(--suave)}
.msg{padding:12px 16px;margin:12px 0;border-radius:6px;background:var(--papel)}
.msg.adm{background:var(--resp);border-left:4px solid var(--acento)}
.msg p{margin:.3em 0;white-space:pre-wrap}.msg small{color:var(--suave)}
.tag{font:14px system-ui;background:var(--ouro);color:#fff;padding:2px 10px;border-radius:12px;vertical-align:middle}
.erro{background:var(--erro);border-left:4px solid #b3261e;padding:10px 14px}
.admins{list-style:none;padding:0;margin-top:28px}
.admins li{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 16px;margin-bottom:8px;background:var(--papel);border-left:4px solid var(--acento)}
.admins form{margin:0}.admins button{margin:0;padding:6px 14px}.admins small{color:var(--suave)}
      
